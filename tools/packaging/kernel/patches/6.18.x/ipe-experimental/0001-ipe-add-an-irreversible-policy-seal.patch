+static ssize_t setseal(struct file *f, const char __user *data,
+		       size_t len, loff_t *offset)
+{
+	struct ipe_policy *ap;
+	bool value;
+	int rc = 0;
+
+	if (!file_ns_capable(f, &init_user_ns, CAP_MAC_ADMIN))
+		return -EPERM;
+
+	rc = kstrtobool_from_user(data, len, &value);
+	if (rc)
+		return rc;
+	if (!value)
+		return -EINVAL;
+
+	mutex_lock(&ipe_policy_lock);
+	if (READ_ONCE(ipe_policy_sealed))
+		goto out;
+
+	ap = rcu_dereference_protected(ipe_active_policy,
+				       lockdep_is_held(&ipe_policy_lock));
+	if (!ap || !READ_ONCE(enforce)) {
+		rc = -EINVAL;
+		goto out;
+	}
+
+	WRITE_ONCE(ipe_policy_sealed, true);
+out:
+	mutex_unlock(&ipe_policy_lock);
+	return rc ?: len;
+}
+
+static ssize_t getseal(struct file *f, char __user *data,
+		       size_t len, loff_t *offset)
+{
+	const char *result = READ_ONCE(ipe_policy_sealed) ? "1" : "0";
+
+	return simple_read_from_buffer(data, len, offset, result, 1);
+}
