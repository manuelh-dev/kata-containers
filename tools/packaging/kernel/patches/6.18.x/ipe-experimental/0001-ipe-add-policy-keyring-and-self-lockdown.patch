+/**
+ * ipe_evaluate_config() - Evaluate an IPE securityfs configuration change.
+ *
+ * Callers must hold ipe_policy_lock across this decision and the associated
+ * mutation. This makes the policy transition to an IPE_CONFIG lockdown
+ * atomic with respect to later writers of IPE's control plane.
+ */
+int ipe_evaluate_config(void)
+{
+	struct ipe_eval_ctx ctx = IPE_EVAL_CTX_INIT;
+
+	ipe_build_eval_ctx(&ctx, NULL, IPE_OP_IPE_CONFIG, IPE_HOOK_CONFIG);
+	return ipe_evaluate_event(&ctx);
+}
+
 /* Set the right module name */
 #ifdef KBUILD_MODNAME
 #undef KBUILD_MODNAME
