 DEFINE_MUTEX(ipe_policy_lock);
 
+static struct key *ipe_keyring __ro_after_init;
+static bool ipe_keyring_unsealed __ro_after_init;
+
+/* Keep the kernel command-line spelling stable when IPE is built in. */
+#ifdef KBUILD_MODNAME
+#undef KBUILD_MODNAME
+#define KBUILD_MODNAME "ipe"
+#endif
+module_param_named(keyring_unsealed, ipe_keyring_unsealed, bool, 0444);
+MODULE_PARM_DESC(keyring_unsealed,
+		 "Leave the IPE policy verification keyring unsealed");
+
+/**
+ * ipe_init_keyring() - Allocate IPE's purpose-specific policy keyring.
+ *
+ * The ring is sealed empty by default. An explicitly opted-in early userspace
+ * may provision certificates and restrict it; only then is it used to verify
+ * userspace supplied IPE policies.
+ */
+int __init ipe_init_keyring(void)
+{
+	int rc;
+
+	ipe_keyring = keyring_alloc(".ipe", GLOBAL_ROOT_UID, GLOBAL_ROOT_GID,
+				   current_cred(),
+				   KEY_POS_SEARCH |
+				   KEY_USR_VIEW | KEY_USR_READ |
+				   KEY_USR_WRITE | KEY_USR_SEARCH |
+				   KEY_USR_SETATTR,
+				   KEY_ALLOC_NOT_IN_QUOTA, NULL, NULL);
+	if (IS_ERR(ipe_keyring))
+		return PTR_ERR(ipe_keyring);
+
+	if (!ipe_keyring_unsealed) {
+		rc = keyring_restrict(make_key_ref(ipe_keyring, true), NULL, NULL);
+		if (rc) {
+			key_put(ipe_keyring);
+			return rc;
+		}
+	}
+
+	return 0;
+}
+
+static bool ipe_keyring_active(void)
+{
+	return ipe_keyring && ipe_keyring->keys.nr_leaves_on_tree &&
+	       ipe_keyring->restrict_link;
+}
