---
apiVersion: v1
kind: Pod
metadata:
  name: annotated-block-device
  annotations:
    io.katacontainers.experimental.block-device-mounts: >-
      {"mounts":[{"container":"app","volume":"data","devicePath":"/dev/kata-data","mountPath":"/data","fsType":"ext4","mountOptions":["nosuid","nodev"]}]}
spec:
  runtimeClassName: ${RUNTIMECLASS}
  nodeSelector:
    kubernetes.io/hostname: ${NODE_NAME}
  restartPolicy: Never
  securityContext:
    supplementalGroups:
      - 10
  containers:
    - name: app
      image: quay.io/prometheus/busybox:latest
      command: ["sh", "-c", "sleep 3600"]
      securityContext:
        runAsUser: 0
        runAsGroup: 0
      volumeDevices:
        - name: data
          devicePath: /dev/kata-data
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: annotated-block-pvc
