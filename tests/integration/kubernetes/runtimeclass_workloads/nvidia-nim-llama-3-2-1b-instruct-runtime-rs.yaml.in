---
apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME_INSTRUCT}
  labels:
    app: ${POD_NAME_INSTRUCT}
spec:
  # The startup wrapper mounts the persistent block device as root and then
  # drops back to the NIM image's uid/gid before launching its normal command.
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
  restartPolicy: OnFailure
  runtimeClassName: kata
  imagePullSecrets:
    - name: ngc-secret-instruct
  containers:
  - name: ${POD_NAME_INSTRUCT}
    image: nvcr.io/nim/meta/llama-3.2-1b-instruct:1.12.0
    command:
      - /bin/sh
      - -ec
    args:
      - |
        mount -t ext4 -o noatime /dev/nim-cache /opt/nim/.cache
        chown 1000:1000 /dev/nvidia* /dev/dri/* 2>/dev/null || true
        exec setpriv --reuid=1000 --regid=1000 --init-groups \
          /opt/nvidia/nvidia_entrypoint.sh /opt/nim/start_server.sh
    securityContext:
      runAsUser: 0
      runAsGroup: 0
      capabilities:
        add: ["SYS_ADMIN"]
    # Ports exposed by the container:
    ports:
      - containerPort: 8000
        name: http-openai
    livenessProbe:
      httpGet:
        path: /v1/health/live
        port: http-openai
      initialDelaySeconds: 15
      periodSeconds: 10
      timeoutSeconds: 1
      successThreshold: 1
      failureThreshold: 3
    readinessProbe:
      httpGet:
        path: /v1/health/ready
        port: http-openai
      initialDelaySeconds: 15
      periodSeconds: 10
      timeoutSeconds: 1
      successThreshold: 1
      failureThreshold: 3
    startupProbe:
      httpGet:
        path: /v1/health/ready
        port: http-openai
      initialDelaySeconds: 60
      periodSeconds: 10
      timeoutSeconds: 1
      successThreshold: 1
      # 1320s window, wider than POD_READY_TIMEOUT_INSTRUCT in k8s-nvidia-nim.bats
      failureThreshold: 126
    env:
      - name: NGC_API_KEY
        valueFrom:
          secretKeyRef:
            name: ngc-api-key-instruct
            key: api-key
      - name: NIM_JSONL_LOGGING
        value: "1"
      - name: NIM_LOG_LEVEL
        value: "INFO"
    # GPU resource limit (for NVIDIA GPU)
    resources:
      limits:
        nvidia.com/pgpu: "1"
        cpu: "16"
        memory: "48Gi"
    volumeDevices:
      - name: nim-cache
        devicePath: /dev/nim-cache

  volumes:
  - name: nim-cache
    persistentVolumeClaim:
      claimName: nim-cache-block-pvc-instruct
---
apiVersion: v1
kind: Secret
metadata:
  name: ngc-secret-instruct
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: ${DOCKER_CONFIG_JSON}
---
apiVersion: v1
kind: Secret
metadata:
  name: ngc-api-key-instruct
type: Opaque
data:
  api-key: "${NGC_API_KEY_BASE64}"
